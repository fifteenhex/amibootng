#!/bin/busybox sh
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
grep -E '^(Model|CPU|FPU|MMU)' /proc/hardware /proc/cpuinfo
# shells on the screen and the serial port
setsid sh -c 'exec sh -l <>/dev/tty1 >&0 2>&1' &
exec setsid sh -c 'exec sh -l <>/dev/ttyS0 >&0 2>&1'
